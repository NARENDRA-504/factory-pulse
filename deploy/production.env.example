# Copy to .env.deploy locally, never commit actual values.
# Container DB host must be reachable FROM the container, not 127.0.0.1.
# On Docker Desktop, host.docker.internal reaches the PC; MySQL account host rules
# must already permit that connection. Do not widen the runtime account privileges.
DATABASE_URL=mysql+pymysql://REPLACE_USER:REPLACE_URL_ENCODED_PASSWORD@REPLACE_DB_HOST:3306/ziro_manufacturing
SIMULATOR_API_KEY=REPLACE_WITH_PRIVATE_RANDOM_KEY_AT_LEAST_32_CHARACTERS
CORS_ORIGINS=https://REPLACE_WITH_YOUR_FRONTEND_HOST
# Optional compose.https.yaml gateway: hostname only, no scheme or path.
FACTORYPULSE_DOMAIN=REPLACE_WITH_YOUR_FRONTEND_HOST
FACTORY_TIMEZONE=Asia/Kolkata
GEMINI_API_KEY=
GEMINI_MODEL=
# Optional private network control/health connection; never expose the Simulator.
# SIMULATOR_CONTROL_URL=https://your-private-simulator-api
# SIMULATOR_CONTROL_API_KEY=private_simulator_control_key
# Optional voice models: use only provider model IDs actually available to you.
# Copy approved model/vector artifacts separately into the runtime volume if needed.
