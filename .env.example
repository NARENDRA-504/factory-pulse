# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"
GEMINI_MODEL=""

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Frontend URL for the separately hosted FactoryPulse FastAPI service.
# For local development, use http://127.0.0.1:8001 (the AI Simulator defaults to 8000).
VITE_API_BASE_URL="http://127.0.0.1:8001"

# Login uses the MySQL users table and hashed passwords by default.
# Demo personas are available only when APP_ENV=development/test and this is true.
APP_ENV="production"
DEMO_AUTH_ENABLED="false"
CORS_ORIGINS="http://127.0.0.1:3000,http://localhost:3000"
FACTORY_TIMEZONE="UTC"

# FastAPI telemetry persistence. Configure only in the backend environment.
# URL-encode special characters in the database password.
DATABASE_URL="mysql+pymysql://<user>:<password>@<host>:3306/<database>"

# Required server-side credential for the separate AI Simulator.
# Generate a private random value; never put it in VITE_* variables or frontend code.
SIMULATOR_API_KEY="REPLACE_WITH_A_LONG_RANDOM_SECRET"

# Reserved Supabase settings for a future notification-only integration. They are not
# used in this Phase 1 build. Cloud delivery must remain disabled until incident and
# work-order writes commit to MySQL and Supabase enforces role/plant channel policies.
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-public-key"
