# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Frontend URL for the separately hosted FactoryPulse FastAPI service.
# For local development, use http://127.0.0.1:8001 (the AI Simulator defaults to 8000).
VITE_API_BASE_URL="http://127.0.0.1:8001"

# FastAPI telemetry persistence. Configure only in the backend environment.
# URL-encode special characters in the database password.
DATABASE_URL="mysql+pymysql://<user>:<password>@<host>:3306/<database>"

# Required server-side credential for the separate AI Simulator.
# Generate a private random value; never put it in VITE_* variables or frontend code.
SIMULATOR_API_KEY="REPLACE_WITH_A_LONG_RANDOM_SECRET"

# SUPABASE REALTIME CONFIGURATION (Optional for Cloud Cross-Device Broadcast):
# Used strictly as an event broker for lightweight notifications to Supervisors and Maintenance.
# MySQL remains the sole system of record for machines, telemetry, incidents, and work orders.
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-public-key"
